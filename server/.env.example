# Copy this file to server/.env and adjust if you need to.
# server/.env is git-ignored; this template is safe to commit.
# The server reads it via `node --env-file=.env` (see package.json scripts).
#
# On Windows you normally do NOT edit this by hand: double-clicking the
# launcher (start.bat at the project root) creates server/.env for you with a
# freshly generated SESSION_SECRET and the embedded database already selected.

# --- Required ---------------------------------------------------------------

# Secret used to sign session cookies. Must be at least 32 characters; the
# server refuses to start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-64-random-characters

# --- Database ---------------------------------------------------------------

# Which database to use:
#   pglite (default) — embedded Postgres-in-WASM. Zero setup: nothing to
#                      install or run alongside the app. Data is persisted on
#                      disk (see PGLITE_DATA). This is what the single-user,
#                      double-click-to-open build uses.
#   pg               — a real PostgreSQL server. Requires DATABASE_URL below.
DB_DRIVER=pglite

# Where the embedded (PGlite) database stores its files. Optional; defaults to
# <project root>/data/pgdata. That folder is git-ignored and is created on
# first launch. Only used when DB_DRIVER=pglite.
#PGLITE_DATA=./data/pgdata

# PostgreSQL connection string. REQUIRED only when DB_DRIVER=pg; ignored for
# the embedded database. Uncomment and fill in to use a real PostgreSQL server.
#DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/student_panel

# --- Optional ---------------------------------------------------------------

# Port to listen on (default 3000).
PORT=3000

# Network interface to bind. Default 127.0.0.1 keeps the app on this computer
# only — right for a single-user desktop install. Set 0.0.0.0 to expose it to
# other machines on your LAN.
HOST=127.0.0.1

# Set to "production" in real deployments. Turns on combined access logging and
# is a common signal to other tooling.
NODE_ENV=production

# Whether the session cookie is marked Secure (HTTPS-only). Values:
#   auto  (default) — Secure when the request arrives over HTTPS, including
#                     through a trusted reverse proxy (X-Forwarded-Proto).
#   true            — always Secure. Use once you always serve over HTTPS; it
#                     stops a misconfigured proxy from downgrading the cookie.
#   false           — never Secure. Only for a deliberately HTTP-only LAN box.
SESSION_COOKIE_SECURE=auto

# How many reverse-proxy hops to trust for X-Forwarded-* headers. Leave off (0)
# when the app faces the network directly — otherwise clients could spoof their
# IP or protocol. Set to 1 when it runs behind exactly one reverse proxy (see
# the HTTPS section of the README). Also accepts true/false or a CIDR/'loopback'.
TRUST_PROXY=0

# Whether to enforce the CSRF Origin/Referer check. 'auto' (default) turns it on
# only when NODE_ENV=production, because in development the Vite dev server is a
# different origin and would be wrongly rejected. The double-submit CSRF token
# runs in every mode regardless. Use true/false to force it.
CSRF_CHECK_ORIGIN=auto
