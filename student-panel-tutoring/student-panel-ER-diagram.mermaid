erDiagram
  settings {
    text key PK
    text value
    timestamptz updated_at
  }
  preferences {
    smallint id PK
    jsonb settings
    timestamptz updated_at
  }
  saved_views {
    uuid id PK
    text name
    jsonb config
    timestamptz created_at
    timestamptz updated_at
  }
  user_sessions {
    varchar sid PK
    json sess
    timestamp expire
  }
  audit_log {
    bigint id PK
    timestamptz occurred_at
    text actor
    text action
    text entity_type
    text entity_id
    jsonb details
  }
  students {
    uuid id PK
    text student_code UK
    text full_name
    date birthdate
    text gender
    jsonb extra
    timestamptz created_at
    timestamptz deleted_at
  }
  student_field_definitions {
    uuid id PK
    text label
    text field_type
    jsonb choices
    boolean is_restricted
    integer sort_order
    timestamptz archived_at
    timestamptz created_at
  }
  student_groups {
    uuid id PK
    text name
    uuid parent_id FK
    integer sort_order
    timestamptz archived_at
    timestamptz created_at
  }
  student_group_members {
    uuid student_id PK, FK
    uuid group_id PK, FK
    timestamptz added_at
  }
  parameters {
    uuid id PK
    uuid parent_id FK
    text name
    text unit
    numeric min_value
    numeric max_value
    numeric norm_min
    numeric norm_max
    jsonb extra
    integer sort_order
    timestamptz archived_at
    timestamptz created_at
  }
  parameter_assignments {
    uuid id PK
    uuid parameter_id FK
    uuid group_id FK
    uuid student_id FK
    timestamptz created_at
  }
  periods {
    uuid id PK
    text name
    date start_date
    date end_date
    integer sort_order
    timestamptz archived_at
    timestamptz created_at
  }
  period_assignments {
    uuid id PK
    uuid period_id FK
    uuid group_id FK
    uuid student_id FK
    timestamptz created_at
  }
  evaluations {
    uuid id PK
    uuid group_id FK
    uuid student_id FK
    uuid parameter_id FK
    uuid period_id FK
    numeric value
    text comment
    timestamptz locked_at
    timestamptz created_at
    timestamptz updated_at
  }
  tasks {
    uuid id PK
    text title
    text description
    uuid parameter_id FK
    jsonb extra
    integer sort_order
    timestamptz archived_at
    timestamptz created_at
  }
  task_assignments {
    uuid id PK
    uuid task_id FK
    uuid group_id FK
    uuid student_id FK
    uuid period_id FK
    boolean done
    timestamptz done_at
    timestamptz created_at
  }

  students ||--o{ student_group_members : "member in"
  student_groups ||--o{ student_group_members : "contains"
  student_groups |o--o{ student_groups : "parent of"
  parameters |o--o{ parameters : "parent of"
  parameters ||--o{ parameter_assignments : "applies"
  student_groups |o--o{ parameter_assignments : "target (XOR)"
  students |o--o{ parameter_assignments : "target (XOR)"
  periods ||--o{ period_assignments : "scheduled"
  student_groups |o--o{ period_assignments : "target (XOR)"
  students |o--o{ period_assignments : "target (XOR)"
  student_groups ||--o{ evaluations : "scored in"
  students |o--o{ evaluations : "scored (optional)"
  parameters ||--o{ evaluations : "measures"
  periods ||--o{ evaluations : "during"
  parameters |o--o{ tasks : "relates to (optional)"
  tasks ||--o{ task_assignments : "given via"
  student_groups |o--o{ task_assignments : "target (XOR)"
  students |o--o{ task_assignments : "target (XOR)"
  periods |o--o{ task_assignments : "scope (optional)"
