# The agent's own configuration. Copy to agent/.env and fill in.
# Never commit the real .env (it holds the kiosk login and any API keys).

# Where the Student Panel server runs.
PANEL_BASE_URL=http://localhost:3000

# The kiosk machine user (create with, from server/):
#   npm run create-user -- cafe-kiosk "Cafe Kiosk (voice)" Kiosk
KIOSK_USERNAME=cafe-kiosk
KIOSK_PASSWORD=change-me

# Rollout stage 0-4 (docs/voice-agent-architecture.md §9):
#   0 button kiosk only — voice off, no dialogue actions
#   1 STT display     — speech shows as text, no actions
#   2 read-only Q&A   — spoken menu/balance answers, still no writes
#   3 confirmed writes — spoken yes AND screen confirm required
#   4 spoken yes alone (screen shows the receipt)
VOICE_STAGE=2

# Dialogue language: default 'fa'; the agent also detects the language of
# every utterance (Persian script → fa, Latin → en) and both «فارسی» and
# "english" switch it on the fly.
AGENT_LANGUAGE=fa

# Kiosk screen (the confirm/cancel/mute page).
KIOSK_PORT=3100

# Optional Postgres URL for the retained transcripts (voice_transcripts
# table, migration 027). Without it, transcripts go to agent/logs/*.jsonl.
# At stage 3+ use a least-privilege role limited to that table.
AGENT_DATABASE_URL=

# ---------------------------------------------------------------------------
# LLM brain — three options, auto-detected in this order:
#   1. LLM_PROVIDER=openai + LLM_BASE_URL: ANY OpenAI-compatible chat API
#      (OpenAI, OpenRouter, Groq, Together, local llama.cpp server / LM
#      Studio / vLLM). LLM_API_KEY optional for local servers.
#   2. Ollama native (auto-detected when OLLAMA_URL answers).
#   3. No model at all: the built-in Persian/English rule brain runs the
#      dialogue (menu, balance, cart, confirmation protocol all work).
# LLM_PROVIDER=auto|openai|ollama|none
LLM_PROVIDER=auto
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------------------------------------------------------------------------
# STT — whisper.cpp locally, or any OpenAI-compatible transcription API.
# STT_PROVIDER=auto|whisper|openai|none
STT_PROVIDER=auto
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
WHISPER_BIN=
WHISPER_MODEL=

# ---------------------------------------------------------------------------
# TTS — Piper locally, or an OpenAI-compatible /audio/speech endpoint.
# TTS_PROVIDER=auto|piper|openai|none
TTS_PROVIDER=auto
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=onyx
PIPER_BIN=
PIPER_VOICE=
PIPER_CONFIG=

# Capture tuning (RMS voice-activity detector on the 16 kHz mono stream).
AUDIO_DEVICE=          # empty = arecord's default; e.g. hw:1,0
VAD_THRESHOLD=500      # RMS level that counts as speech
VAD_START_MS=150       # speech must last this long to open a segment
VAD_END_MS=700         # silence this long closes a segment
