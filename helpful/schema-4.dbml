// Student evaluation schema, version 4 (Postgres 15+)
// Based on schema-3.dbml. Changes in this version:
//  - periods: only active sessions count; archived/canceled sessions leave the period
//  - alerts: no archived_at; one OPEN alert per kind/session; selected cells must be answered
//  - evaluation: an empty row is a selected but unanswered cell (the requirement itself);
//    comment-only allowed; min/max enforced; no whole-group score on an individual
//    assignment; membership dates checked; archived/canceled refs blocked
//  - assignment.name; blank assignment codes are auto-generated; no code cascade
//  - task_template catalog + task.template_id; templates are snapshots for sessions
//  - membership/task have no archived_at; membership dates and delete+audit are enough
//  - secret table for password hashes / app-encrypted values; setting is public config
//  - audit helper handles tables without archived_at

Enum gender_type {
  male
  female
}

Enum audit_action {
  insert
  update
  archive
  restore
  delete
  lock
  unlock
}

Enum alert_kind {
  session_incomplete // more kinds can be added later with: alter type alert_kind add value '...'
}

Table student [headercolor: #175e7a] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  code text [not null]
  full_name text [not null]
  gender gender_type [not null]
  birth_date date [not null]
  father_name text [not null]
  national_id text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  indexes {
    code [unique, name: 's_c_u']
    national_id [unique, name: 's_n_u']
  }
}

Table student_group [headercolor: #175e7a] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  code text [not null]
  name text [not null]
  parent_id uuid
  sort_order integer [not null, default: 0] // order among siblings in the tree
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  indexes {
    code [unique, name: 'g_c_u']
    parent_id [name: 'g_p_i']
  }

  checks {
    `sort_order >= 0` [name: 'student_group_sort_ck']
  }
}

Table membership [headercolor: #175e7a] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  student_id uuid [not null]
  group_id uuid [not null]
  joined_on date [not null]
  left_on date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (student_id, group_id, joined_on) [unique, name: 'm_sgj_u']
    group_id [name: 'm_g_i']
  }

  checks {
    `left_on is null or left_on >= joined_on` [name: 'membership_dates_ck']
  }
}

Table teacher [headercolor: #175e7a] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  code text [not null]
  full_name text [not null]
  birth_date date [not null]
  national_id text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  indexes {
    code [unique, name: 't_c_u']
    national_id [unique, name: 't_n_u']
  }
}

Table parameter [headercolor: #175e7a] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  parent_id uuid
  name text [not null]
  min_value integer // optional; both values are checked against this range
  max_value integer // optional
  sort_order integer [not null, default: 0] // column order in scores and reports
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  indexes {
    name [unique, name: 'p_n_u']
    parent_id [name: 'p_p_i']
  }

  checks {
    `min_value <= max_value` [name: 'parameter_range_ck'] // passes when either one is empty
    `sort_order >= 0` [name: 'parameter_sort_ck']
  }

  Note: 'Every parameter is scorable, including a parent. Min/max apply to both quality and quantity; narrowing a range is blocked while an active answered evaluation would fall outside it.'
}

Table interval [headercolor: #175e7a] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name text [not null]
  every interval [not null] // e.g. '7 days', '1 month', '3 days'
  sort_order integer [not null, default: 0] // order in the rhythm picker
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  indexes {
    name [unique, name: 'iv_n_u']
  }

  checks {
    `every > interval '0'` [name: 'interval_positive_ck']
    `sort_order >= 0` [name: 'interval_sort_ck']
  }

  Note: 'The default interval between the sessions of an assignment. Individual sessions can still be moved (session.moved_to).'
}

Table assignment [headercolor: #175e7a] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  code text [not null] // target-rich, unique; session codes start with it
  name text // editable display name; the code is the stable identity
  teacher_id uuid [not null]
  interval_id uuid [not null]
  group_id uuid // whole group
  membership_id uuid // or one member (individual sessions)
  anchor_date date [not null]
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  indexes {
    code [unique, name: 'a_c_u']
    group_id [name: 'a_g_i']
    membership_id [name: 'a_m_i']
    interval_id [name: 'a_i_i']
  }

  checks {
    `num_nonnulls(group_id, membership_id) = 1` [name: 'assignment_target_ck']
    `char_length(btrim(code)) between 1 and 40` [name: 'assignment_code_ck']
    `name is null or char_length(btrim(name)) between 1 and 120` [name: 'assignment_name_ck']
    `sort_order >= 0` [name: 'assignment_sort_ck']
  }

  Note: 'Exactly one of group_id / membership_id. Partial unique indexes keep one assignment per teacher/interval/target. A blank code is auto-generated when omitted; the code may change only while no session exists. The name can change at any time. Code changes never cascade.'
}

Table period [headercolor: #175e7a] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  assignment_id uuid [not null]
  seq integer [not null] // 1, 2, 3... inside the assignment
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  indexes {
    (assignment_id, seq) [unique, name: 'pr_as_u']
  }

  Note: 'Every four active attached sessions of an assignment form one period. A session joins when it gets its first answer, not when an empty cell is selected. Archived and canceled sessions are detached and do not occupy a slot (option C); a restored session with history rejoins the newest period with room. is_complete means four active attached sessions, not four fully answered sessions.'
}

Table session [headercolor: #175e7a] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  assignment_id uuid [not null]
  seq integer [not null] // 1, 2, 3... inside the assignment; filled by a trigger
  code text [not null] // "<assignment code>-001", "-002"...; generated and immutable
  planned_date date [not null] // anchor_date + n * interval.every; never edited, so the schedule stays stable
  moved_to date // optional: the session was moved to this date
  session_date date // generated: coalesce(moved_to, planned_date), the date it really takes place
  canceled_at timestamptz // set = canceled. A canceled session cannot receive or keep an active evaluation
  note text // optional reason for a move or a cancellation
  period_id uuid // set when the session gets its first answer; cleared when archived/canceled or when no answer remains
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  indexes {
    code [unique, name: 'se_c_u']
    (assignment_id, planned_date) [unique, name: 'se_as_u']
    (assignment_id, seq) [unique, name: 'se_aq_u']
    session_date [name: 'se_d_i']
    period_id [name: 'se_p_i']
  }

  Note: 'Sessions are created for every planned date by generate_sessions(), whether or not anything happens. A session without answers means it was not attended; an empty evaluation row is a selected but unanswered cell. It is only canceled when canceled_at is set. Canceling is blocked while an active evaluation row exists.'
}

Table evaluation [headercolor: #175e7a] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  session_id uuid [not null]
  parameter_id uuid [not null]
  membership_id uuid // null = the group as a whole; otherwise one member
  quality_value integer
  quantity_value integer
  comment text // one note for the whole score row (max 500)
  locked_at timestamptz // null = open; set = changes need an override reason
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  indexes {
    (session_id, parameter_id, membership_id) [unique, name: 'evaluation_u'] // NULLS NOT DISTINCT
    parameter_id [name: 'e_p_i']
    membership_id [name: 'e_m_i']
  }

  checks {
    `comment is null or char_length(comment) <= 500` [name: 'evaluation_comment_ck']
  }

  Note: 'One row = one selected parameter + one target. An empty row (no quality, no quantity, no comment) is selected but unanswered; filling any value or a non-whitespace comment answers it. A group row and member rows are independent cells; no row is for both at once. Archived/canceled sessions, archived parameters, and archived assignments cannot be newly evaluated. An archived evaluation is history and cannot be edited unless it is restored to active. A session cannot be canceled while an active evaluation row exists. A locked row can only change when the app sets app.override_reason; the reason is copied into audit_log.reason.'
}

Table task_template [headercolor: #175e7a] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  title text [not null]
  description text
  parameter_id uuid // optional
  extra jsonb [not null, default: '{}']
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  indexes {
    parameter_id [name: 'tt_p_i']
    sort_order [name: 'tt_s_i']
  }

  checks {
    `char_length(btrim(title)) between 1 and 120` [name: 'task_template_title_length']
    `description is null or char_length(description) <= 2000` [name: 'task_template_description_length']
    `jsonb_typeof(extra) = 'object'` [name: 'task_template_extra_ck']
    `sort_order >= 0` [name: 'task_template_sort_ck']
  }

  Note: 'A reusable definition, not a live parent. create_task_from_template() copies the fields into a task row. Later template edits never change existing tasks. assign_task_template() can copy it to many sessions at once.'
}

Table task [headercolor: #175e7a] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  session_id uuid [not null]
  template_id uuid // provenance only; deleting the template keeps this task
  parameter_id uuid // optional
  membership_id uuid // null = the task is for the whole group / the session
  title text [not null]
  description text
  extra jsonb [not null, default: '{}']
  done boolean [not null, default: false]
  done_at timestamptz
  sort_order integer [not null, default: 0] // order of tasks inside one session
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (session_id, parameter_id, membership_id) [name: 'ta_spm_i']
    template_id [name: 'ta_t_i']
    parameter_id [name: 'ta_p_i']
    membership_id [name: 'ta_m_i']
    (session_id, sort_order) [name: 'ta_sso_i']
  }

  checks {
    `char_length(btrim(title)) between 1 and 120` [name: 'task_title_length']
    `description is null or char_length(description) <= 2000` [name: 'task_description_length']
    `done_at is null or done` [name: 'task_done_ck']
    `jsonb_typeof(extra) = 'object'` [name: 'task_extra_ck']
    `sort_order >= 0` [name: 'task_sort_ck']
  }

  Note: 'One editable snapshot per session. Editing a task affects only that task. A task may target the whole group or one member; on an individual assignment, a null target means a session-level task. No archived_at: delete it and the audit log keeps history.'
}

Table alert [headercolor: #175e7a] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  kind alert_kind [not null]
  session_id uuid
  message text
  resolved_at timestamptz // null = still open
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    session_id [name: 'alr_s_i']
  }

  Note: 'No archived_at: delete an alert when it is no longer useful; the audit log keeps the history. One OPEN alert per kind/session (partial unique index), so a resolved alert can be raised again. Resolution waits until every selected evaluation cell has an answer.'
}

Table setting [headercolor: #7a3a17] {
  key text [pk, not null]
  value text [not null]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `char_length(btrim(key)) between 1 and 120` [name: 'setting_key_ck']
  }

  Note: 'Public app-wide key/value configuration only. NEVER store a secret here. Deliberately not audited. No archived_at.'
}

Table preference [headercolor: #7a3a17] {
  id smallint [pk, not null, default: 1]
  settings jsonb [not null, default: '{}']
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `id = 1` [name: 'preference_single_row_ck']
    `jsonb_typeof(settings) = 'object'` [name: 'preference_object_ck']
  }

  Note: 'One global row (id = 1), seeded by the SQL. UI-only, deliberately not audited. Only fits a single-operator UI; make it per-teacher if preferences become personal.'
}

Table secret [headercolor: #7a3a17] {
  key text [pk, not null]
  value_hash text // Argon2id/bcrypt password hash
  value_encrypted bytea // app-encrypted API key, SMTP password, ...
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `char_length(btrim(key)) between 1 and 120` [name: 'secret_key_ck']
    `num_nonnulls(value_hash, value_encrypted) = 1` [name: 'secret_value_ck']
    `value_hash is null or char_length(value_hash) > 0` [name: 'secret_hash_ck']
    `value_encrypted is null or octet_length(value_encrypted) > 0` [name: 'secret_cipher_ck']
  }

  Note: 'Never plaintext. Exactly one of value_hash / value_encrypted. Encryption/decryption happens in the app with a key outside the database. Deliberately not audited. Restrict this table to the application role and keep it out of read-only dumps/views.'
}

Table audit_log [headercolor: #7a3a17] {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  table_name text [not null]
  record_id uuid [not null] // no FK on purpose: it points at rows in any table
  action audit_action [not null]
  old_data jsonb // row before the change (null on insert)
  new_data jsonb // row after the change (null on delete)
  changed_by text // who made the change, taken from the app.user_id session setting
  reason text // written override reason for a locked evaluation
  changed_at timestamptz [not null, default: `now()`]

  indexes {
    (table_name, record_id, changed_at) [name: 'al_trc_i']
    changed_at [name: 'al_c_i']
  }

  Note: 'Append-only. Filled by the audit trigger on the 13 audited working tables; the app never writes here directly. setting, preference, and secret are not audited.'
}

Ref: student_group.parent_id > student_group.id
Ref: membership.student_id > student.id
Ref: membership.group_id > student_group.id
Ref: parameter.parent_id > parameter.id
Ref: assignment.teacher_id > teacher.id
Ref: assignment.interval_id > interval.id
Ref: assignment.group_id > student_group.id
Ref: assignment.membership_id > membership.id
Ref: period.assignment_id > assignment.id
Ref: session.assignment_id > assignment.id
Ref: session.period_id > period.id
Ref: evaluation.session_id > session.id
Ref: evaluation.parameter_id > parameter.id
Ref: evaluation.membership_id > membership.id
Ref: task_template.parameter_id > parameter.id
Ref: task.session_id > session.id
Ref: task.template_id > task_template.id
Ref: task.parameter_id > parameter.id
Ref: task.membership_id > membership.id
Ref: alert.session_id > session.id

/*
SQL notes (DBML cannot express these; schema-4.sql has all of them):

-- One assignment per teacher/interval/target. Partial indexes because NULLs count as distinct.
create unique index assignment_group_u on assignment (teacher_id, interval_id, group_id)
  where group_id is not null;
create unique index assignment_member_u on assignment (teacher_id, interval_id, membership_id)
  where membership_id is not null;

-- One evaluation cell per session/parameter/target (Postgres 15+). NULL membership_id = whole group.
create unique index evaluation_u on evaluation (session_id, parameter_id, membership_id)
  nulls not distinct;

-- One OPEN alert per kind and session; resolved/deleted alerts do not block a new one.
create unique index alr_ks_open_u on alert (kind, session_id)
  where session_id is not null and resolved_at is null;

-- session.session_date is a generated column:
--   session_date date generated always as (coalesce(moved_to, planned_date)) stored

-- session.code is globally unique:
--   assignment.code is unique, session.seq is unique inside the assignment,
--   and the trigger builds <assignment.code>-<seq>. The trigger overwrites any supplied code.
--   Sequences above 999 sort as text after "-999"; keep assignments below 1000 sessions
--   or add zero padding based on the expected maximum.

-- Triggers and functions (see schema-4.sql):
--   set_updated_at, audit_row                     on the 13 audited tables
--   setting_updated, preference_updated, secret_updated  only updated_at maintenance
--   session_set_code                              fills session.seq and session.code
--   session_identity_guard                        blocks changes to assignment_id / seq / code
--   assignment_set_code                           fills a blank assignment code
--   assignment_code_guard                         blocks changing an assignment code after sessions exist
--   evaluation_lock_guard                         blocks changes to a locked score without app.override_reason
--   check_membership_in_assignment                target belongs to the assignment and is active on session_date
--   check_active_references                       blocks new, restored, or edited rows pointing at archived refs
--   evaluation_edit_guard                         blocks editing an archived row unless it is restored
--   check_session_not_canceled                    a canceled session cannot receive/keep an active evaluation
--   session_cancel_guard                          blocks canceling while an active evaluation row exists
--   check_parameter_range / _change               enforces min/max on entry and when narrowing
--   session_period_activity_guard / reactivate    detaches inactive sessions, reattaches restores
--   evaluation_is_answered                        true when a cell has a value or non-whitespace comment
--   session_is_complete                           every active selected cell is answered
--   evaluation_after_change                       attaches on first answer, detaches on last answer/delete/archive,
--                                                 and resolves only complete alerts
--   detach_session_if_unscored                    removes a session from its period when no answer remains
--   resolve_session_alerts                        per-session advisory lock + resolve only when complete
--   generate_sessions(until, assignment)          creates all missing sessions
--   create_task_from_template / assign_task_template  snapshot a template into one or many sessions
--   raise_overdue_alerts(grace)                   one session at a time, same advisory lock, then cleanup pass

-- Archiving = set archived_at = now() instead of deleting. Unique indexes still apply to
-- archived rows; archived assignments and evaluations keep their codes/cells reserved.
*/
